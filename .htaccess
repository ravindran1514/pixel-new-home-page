# Pixel Web Solutions homepage: Apache settings
# Target: https://approvals.pixelwebsolutions.com/demo/
#
# Upload the contents of this folder (index.html, support.js, image-slot.js,
# assets/ and this .htaccess) straight into the /demo/ directory. Nothing below
# names /demo, so the same files also work from any other folder or a domain root.
# Every block is wrapped in <IfModule>, so a missing module is skipped instead of
# causing a 500 error.

# ---------------------------------------------------------------------------
# Entry page and folders
# ---------------------------------------------------------------------------
DirectoryIndex index.html

# The page loads its files with relative paths (assets/..., ./support.js), so it
# has to be opened as /demo/ with the trailing slash. Apache adds the slash by
# default; this keeps it on in case the host turned it off.
<IfModule mod_dir.c>
  DirectorySlash On
</IfModule>

# No file listings for folders such as assets/images/
Options -Indexes

# ---------------------------------------------------------------------------
# Never serve hidden files, backups or archives (for example an uploaded zip).
# .image-slots.state.json stays reachable because image-slot.js asks for it.
# ---------------------------------------------------------------------------
<FilesMatch "(^\.(?!image-slots\.state\.json$)|\.(bak|old|orig|swp|log|zip|tar|gz|tgz|rar|7z|sql|md)$|~$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# ---------------------------------------------------------------------------
# File types. Older servers do not know .webp, and nosniff below needs exact types.
# ---------------------------------------------------------------------------
AddDefaultCharset utf-8
<IfModule mod_mime.c>
  AddType text/css .css
  AddType text/javascript .js
  AddType application/json .json
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddCharset utf-8 .css .js .json .svg
</IfModule>

# ---------------------------------------------------------------------------
# Headers
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
  # This is an approval copy of www.pixelwebsolutions.com. Keep it out of search
  # results so it never competes with the live site. Delete this line only if
  # this folder becomes the live site.
  Header always set X-Robots-Tag "noindex, nofollow"

  # Safe security headers. They do not change how the page looks or loads.
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ---------------------------------------------------------------------------
# Compression for text files
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
  <IfModule mod_filter.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
  </IfModule>
</IfModule>

# ---------------------------------------------------------------------------
# Caching. Kept short on purpose because this copy changes during approvals.
# HTML, CSS and JS are re-checked on every visit (a quick 304 when unchanged), so a
# new upload shows immediately. Images are reused for one hour.
# For the live site, images can go to "access plus 30 days".
# ---------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 0 seconds"
  ExpiresByType image/webp "access plus 1 hour"
  ExpiresByType image/png "access plus 1 hour"
  ExpiresByType image/jpeg "access plus 1 hour"
  ExpiresByType image/svg+xml "access plus 1 hour"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(html|css|js|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# ---------------------------------------------------------------------------
# Optional: send http:// visitors to https://.
# Leave this commented if the hosting panel already forces HTTPS, because having
# both can cause a redirect loop. Remove the leading "# " on all 6 lines to enable.
# ---------------------------------------------------------------------------
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} !=on
#   RewriteCond %{HTTP:X-Forwarded-Proto} !=https
#   RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>
